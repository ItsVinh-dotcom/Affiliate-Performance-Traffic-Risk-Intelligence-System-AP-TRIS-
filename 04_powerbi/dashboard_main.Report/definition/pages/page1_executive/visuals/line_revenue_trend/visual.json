{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visual/1.4.0/schema.json",
  "name": "line_revenue_trend",
  "position": {
    "x": 40,
    "y": 210,
    "z": 0,
    "width": 1100,
    "height": 420
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "daily_campaign_kpi"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "daily_campaign_kpi.date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Gross Revenue"
                }
              },
              "queryRef": "_Measures.Gross Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Net Platform Margin"
                }
              },
              "queryRef": "_Measures.Net Platform Margin"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Gross Revenue vs Net Margin over Time'"
                }
              }
            }
          }
        }
      ]
    }
  }
}