{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "scatter_campaign",
  "position": {
    "x": 16,
    "y": 144,
    "z": 1000,
    "height": 300,
    "width": 616,
    "tabOrder": 1000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_offers"
                    }
                  },
                  "Property": "offer_name"
                }
              },
              "queryRef": "dim_offers.offer_name",
              "nativeQueryRef": "offer_name",
              "active": true,
              "displayName": "Offer"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_offers"
                    }
                  },
                  "Property": "vertical"
                }
              },
              "queryRef": "dim_offers.vertical",
              "nativeQueryRef": "vertical",
              "displayName": "Ngành hàng"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Approved Conversions"
                }
              },
              "queryRef": "_Measures.Approved Conversions",
              "nativeQueryRef": "Approved Conversions",
              "displayName": "Đơn duyệt"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Approval Rate %"
                }
              },
              "queryRef": "_Measures.Approval Rate %",
              "nativeQueryRef": "Approval Rate %",
              "active": true,
              "displayName": "Tỷ lệ duyệt"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Margin (M VND)"
                }
              },
              "queryRef": "_Measures.Margin (M VND)",
              "nativeQueryRef": "Margin (M VND)",
              "displayName": "Lãi gộp (tr VNĐ)"
            }
          ]
        }
      }
    },
    "objects": {
      "legend": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "position": {
              "expr": {
                "Literal": {
                  "Value": "'Bottom'"
                }
              }
            }
          }
        }
      ],
      "categoryLabels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Offer: tỷ lệ duyệt × lãi gộp (kích thước = số đơn duyệt)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}