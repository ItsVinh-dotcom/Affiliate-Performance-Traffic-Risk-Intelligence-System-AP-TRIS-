{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visual/1.4.0/schema.json",
  "name": "scatter_campaign",
  "position": {
    "x": 40,
    "y": 40,
    "z": 0,
    "width": 1100,
    "height": 480
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Clicks"
                }
              },
              "queryRef": "_Measures.Total Clicks"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Approval Rate %"
                }
              },
              "queryRef": "_Measures.Approval Rate %"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Net Platform Margin"
                }
              },
              "queryRef": "_Measures.Net Platform Margin"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_offers"
                    }
                  },
                  "Property": "offer_name"
                }
              },
              "queryRef": "dim_offers.offer_name"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Campaign Performance: Volume vs Approval Rate'"
                }
              }
            }
          }
        }
      ]
    }
  }
}